      "identity": "either",
      "scopes": ["docs:document.comment:create", "docs:document.comment:write_only"],
      "doc_url": "https://open.feishu.cn/api-explorer?from=op_doc_tab&apiName=create_v2&project=drive&resource=file.comment&version=v1"
