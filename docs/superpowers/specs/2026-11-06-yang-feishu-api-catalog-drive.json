      "doc_url": "https://open.feishu.cn/document/server-docs/docs/permission/permission-public/get"
    },
    {
      "name": "patch_public_permission",
      "summary": "更新云文档的公开权限设置",
      "method": "PATCH",
      "path": "/open-apis/drive/v1/permissions/{token}/public",
      "path_params": ["token"],
      "query_params": ["type"],
      "body": true,
      "identity": "either",
      "scopes": ["drive:drive", "drive:file", "docs:doc", "sheets:spreadsheet", "wiki:wiki", "bitable:bitable", "docs:permission.setting:write_only"],
      "doc_url": "https://open.feishu.cn/document/server-docs/docs/permission/permission-public/patch"
    },
    {
      "name": "batch_query_comments",
      "summary": "按评论 ID 批量获取云文档评论",
      "method": "POST",
      "path": "/open-apis/drive/v1/files/{file_token}/comments/batch_query",
      "path_params": ["file_token"],
      "query_params": ["file_type", "user_id_type"],
      "body": true,
      "identity": "either",
      "scopes": ["drive:drive", "drive:drive:readonly", "docs:document.comment:read"],
      "doc_url": "https://open.feishu.cn/document/server-docs/docs/CommentAPI/batch_query"
    },
    {
      "name": "create_comment_v2",
      "summary": "添加云文档评论（V2，支持 block 锚点与全局评论）",
      "method": "POST",
      "path": "/open-apis/drive/v1/files/{file_token}/new_comments",
      "path_params": ["file_token"],
      "query_params": [],
