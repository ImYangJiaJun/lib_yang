    {
      "name": "transfer_owner",
      "summary": "转移云文档所有者",
      "method": "POST",
      "path": "/open-apis/drive/v1/permissions/{token}/members/transfer_owner",
      "path_params": ["token"],
      "query_params": ["type", "need_notification", "remove_old_owner", "stay_put", "old_owner_perm"],
      "body": true,
      "identity": "either",
      "scopes": ["drive:drive", "docs:doc", "sheets:spreadsheet", "bitable:bitable", "wiki:wiki", "bitable:app", "docs:permission.member:transfer"],
      "doc_url": "https://open.feishu.cn/document/server-docs/docs/permission/permission-member/transfer_owner"
    },
    {
      "name": "get_public_permission",
      "summary": "获取云文档的公开权限设置",
