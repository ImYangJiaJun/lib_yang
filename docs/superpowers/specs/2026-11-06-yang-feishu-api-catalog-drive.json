{
  "domain": "drive",
  "endpoints": [
    {
      "name": "copy_file",
      "summary": "复制云空间中的文件到指定文件夹",
      "method": "POST",
      "path": "/open-apis/drive/v1/files/{file_token}/copy",
      "path_params": ["file_token"],
      "query_params": ["user_id_type"],
      "body": true,
      "identity": "either",
      "scopes": ["drive:drive", "docs:document:copy"],
      "doc_url": "https://open.feishu.cn/document/server-docs/docs/drive-v1/file/copy"
    },
    {
      "name": "create_folder",
      "summary": "在云空间指定父文件夹下新建文件夹",
      "method": "POST",
      "path": "/open-apis/drive/v1/files/create_folder",
      "path_params": [],
      "query_params": [],
      "body": true,
      "identity": "either",
      "scopes": ["drive:drive", "space:folder:create"],
      "doc_url": "https://open.feishu.cn/document/server-docs/docs/drive-v1/folder/create_folder"
    },
    {
      "name": "list_files",
      "summary": "获取指定文件夹下的文件清单",
      "method": "GET",
      "path": "/open-apis/drive/v1/files",
      "path_params": [],
      "query_params": ["page_size", "page_token", "folder_token", "order_by", "direction", "user_id_type"],
      "body": false,
      "identity": "either",
      "scopes": ["drive:drive", "drive:drive:readonly", "space:document:retrieve"],
      "doc_url": "https://open.feishu.cn/document/server-docs/docs/drive-v1/folder/list"
    },
    {
      "name": "patch_file",
      "summary": "修改云空间文件的标题",
      "method": "PATCH",
      "path": "/open-apis/drive/v1/files/{file_token}",
      "path_params": ["file_token"],
      "query_params": ["type"],
      "body": true,
      "identity": "either",
      "scopes": ["docx:document:write_only", "sheets:spreadsheet:write_only", "base:app:update", "drive:file:upload"],
      "doc_url": "https://open.feishu.cn/api-explorer?from=op_doc_tab&apiName=patch&project=drive&resource=file&version=v1"
    },
    {
      "name": "batch_query_metas",
      "summary": "批量查询文件元数据",
      "method": "POST",
      "path": "/open-apis/drive/v1/metas/batch_query",
      "path_params": [],
      "query_params": ["user_id_type"],
      "body": true,
      "identity": "either",
      "scopes": ["drive:drive", "drive:drive.metadata:readonly"],
      "doc_url": "https://open.feishu.cn/document/server-docs/docs/drive-v1/file/batch_query"
    },
    {
      "name": "auth_permission",
      "summary": "判断当前用户对云文档是否具有指定权限",
      "method": "GET",
      "path": "/open-apis/drive/v1/permissions/{token}/members/auth",
      "path_params": ["token"],
      "query_params": ["type", "action"],
      "body": false,
      "identity": "either",
      "scopes": ["drive:drive", "docs:doc", "sheets:spreadsheet", "bitable:bitable", "wiki:wiki", "bitable:app", "docs:permission.member:auth"],
      "doc_url": "https://open.feishu.cn/document/server-docs/docs/permission/permission-member/auth"
    },
    {
      "name": "create_permission_member",
      "summary": "为云文档添加协作者权限",
      "method": "POST",
      "path": "/open-apis/drive/v1/permissions/{token}/members",
      "path_params": ["token"],
      "query_params": ["type", "need_notification"],
      "body": true,
      "identity": "either",
      "scopes": ["drive:drive", "drive:file", "docs:doc", "sheets:spreadsheet", "wiki:wiki", "bitable:bitable", "bitable:app", "docs:permission.member:create"],
      "doc_url": "https://open.feishu.cn/document/server-docs/docs/permission/permission-member/create"
