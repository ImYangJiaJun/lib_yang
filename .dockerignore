# lib_yang 仓库根 .dockerignore
# 供 yang-system 后端镜像使用（构建上下文必须是仓库根，因为
# project/yang-system 通过相对路径依赖 ../../crates）。
# 本文件只影响 docker build 上下文，不改变 .gitignore 语义。

# VCS 与工具元数据
.git
.gitattributes
.gitignore
.idea
.vscode
.claude
.codegraph
.codex
.agents

# 构建产物与缓存
target
**/target
**/node_modules
**/.quasar
**/dist
**/coverage
**/playwright-report
**/test-results
**/test-results-production

# 本地配置与密钥（禁止进入构建上下文；生产凭据经环境变量/secret 目录注入）
**/.env
project/yang-system/config.toml
project/yang-system/config.local.toml
# 生产/财务配置与部署口令（deploy/ 下这些文件含明文凭据，绝不能进镜像上下文）
project/yang-system/deploy/config.cloud*.toml
project/yang-system/deploy/config.cloud*.toml.*
project/yang-system/deploy/*.ssh-password*
project/yang-system/deploy/.ssh-password*
project/yang-system/deploy/*.mysql-root-password*
project/yang-system/deploy/.mysql-root-password*

# 压缩包与杂项
*.7z

# 飞书联调产物：后端构建上下文是**整个仓库根**（见文件头），不排除的话
# 每次 docker build 都要把 project/yang-system/.tmp-fs（约 200MB / 1500 个文件）
# 送进 docker daemon。后端 Dockerfile 从不 COPY 这些路径，纯粹是浪费。
# 它们同时也是**生产数据与活体 base_token**，不该离开本机。
project/yang-system/.tmp-fs
project/yang-system/.tmp-*
project/yang-system/*.manifest.json
**/*.ndjson

# receivables-system 的部署产物：后端构建上下文是整个 lib_yang 根，
# 这些文件含生产凭据或大体积镜像包，绝不能送进 docker daemon。
project/receivables-system/config.toml
project/receivables-system/deploy/config.cloud*.toml
project/receivables-system/deploy/config.cloud*.toml.*
project/receivables-system/deploy/*.tar
project/receivables-system/deploy/*.tar.gz
project/receivables-system/deploy/.build
project/receivables-system/deploy/.releases
project/receivables-system/deploy/.ssh-password*
project/receivables-system/deploy/.deploy-lock

# inventory-system：本地运行配置、6GB 测试数据、对拍产物与 xlsx fixtures
# 都不参与 Rust 镜像构建；生产凭据只经 DATABASE_URL 环境变量注入。
project/inventory-system/config.toml
project/inventory-system/data
project/inventory-system/parity_runs
project/inventory-system/tests/fixtures
project/inventory-system/frontend/node_modules
