    "OrderByItem_for_SnapshotUser": {
      "description": "排序条目（JSON 形态：`{\"field\": \"id\", \"direction\": \"desc\"}`）。",
      "type": "object",
      "required": [
        "direction",
        "field"
      ],
      "properties": {
        "direction": {
          "description": "方向，缺省为 Asc",
          "allOf": [
