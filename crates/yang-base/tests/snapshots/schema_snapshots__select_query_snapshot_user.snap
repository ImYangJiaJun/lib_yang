{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SelectQuery_for_SnapshotUser",
  "description": "SelectAction 的输入。",
  "type": "object",
  "required": [
    "count_total",
    "order_by",
    "page",
    "page_size",
    "where_clause"
  ],
  "properties": {
    "count_total": {
      "description": "是否额外执行 COUNT 查询",
      "type": "boolean"
    },
    "fields": {
      "description": "选择字段子集（缺省返回全部）",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/definitions/SnapshotUserField"
      }
    },
    "order_by": {
      "description": "排序规则列表",
      "type": "array",
      "items": {
        "$ref": "#/definitions/OrderByItem_for_SnapshotUser"
      }
    },
    "page": {
      "description": "页码（1 起步），缺省 1",
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "page_size": {
      "description": "每页条数，缺省 10，必须 1..=100",
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "where_clause": {
      "description": "where 条件列表（AND 连接），JSON key 为 `\"where\"`",
      "type": "array",
      "items": {
        "$ref": "#/definitions/SnapshotUserWhere"
      }
    }
  },
